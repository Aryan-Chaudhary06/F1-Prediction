import { useRef, useState, useEffect } from "react";
import { motion, useScroll, useTransform, useMotionValue, useSpring } from "framer-motion";
import { getPredictorStatus } from "../api";

export default function Hero() {
  const heroRef = useRef(null);
  const rightPanelRef = useRef(null);

  // ── Scroll-shrink on the left headline ──────────────────────────────
  const { scrollYProgress } = useScroll({
    target: heroRef,
    offset: ["start start", "end start"],
  });
  const scale = useTransform(scrollYProgress, [0, 1], [1, 0.72]);
  const opacity = useTransform(scrollYProgress, [0, 1], [1, 0]);

  // ── Helmet mouse-follow ──────────────────────────────────────────────
  const x = useMotionValue(0);
  const y = useMotionValue(0);
  const springX = useSpring(x, { stiffness: 150, damping: 20 });
  const springY = useSpring(y, { stiffness: 150, damping: 20 });

  const handleMouseMove = (e) => {
    const rect = rightPanelRef.current.getBoundingClientRect();
    const nx = (e.clientX - rect.left - rect.width / 2) / (rect.width / 2);
    const ny = (e.clientY - rect.top - rect.height / 2) / (rect.height / 2);
    x.set(nx * 60);
    y.set(ny * 55);
  };

  const handleMouseLeave = () => {
    x.set(0);
    y.set(0);
  };

  // ── Live status from the real backend ───────────────────────────────
  const [status, setStatus] = useState(null);
  const [statusError, setStatusError] = useState(false);

  useEffect(() => {
    let cancelled = false;
    getPredictorStatus()
      .then((data) => { if (!cancelled) setStatus(data); })
      .catch(() => { if (!cancelled) setStatusError(true); });
    return () => { cancelled = true; };
  }, []);

  const accuracy = status?.metadata?.accuracy;
  const isLive = status?.model_exists && !status?.is_stale;

  return (
    <section ref={heroRef} className="hero">
      {/* LEFT: headline */}
      <motion.div
        className="hero-left"
        style={{ scale, opacity, transformOrigin: "left bottom" }}
      >
        <div className="hero-eyebrow">// F1 Intelligence · Season 2026 · Live</div>

        <h1 className="hero-h1">
          <span className="ln-slide" style={{ animationDelay: "0.15s" }}>Race</span>
          <span className="ln-slide outline" style={{ animationDelay: "0.28s" }}>Mind</span>
          <span className="ln-slide red" style={{ animationDelay: "0.41s" }}>AI</span>
        </h1>

        <div className="hero-rule" />

        <div className="hero-stats">
          <div>
            <div className="hstat-label">Model</div>
            <div className="hstat-val">XGBoost</div>
          </div>
          <div>
            <div className="hstat-label">Status</div>
            <div className={`hstat-val ${isLive ? "pulse" : ""}`}>
              {statusError ? "Offline" : status === null ? "—" : isLive ? "Live" : "Stale"}
            </div>
          </div>
          <div>
            <div className="hstat-label">Accuracy</div>
            <div className="hstat-val" style={{ color: "var(--lime)" }}>
              {accuracy != null ? `${(accuracy * 100).toFixed(1)}%` : statusError ? "N/A" : "…"}
            </div>
          </div>
        </div>
      </motion.div>

      {/* RIGHT: helmet mask zone */}
      <div
        className="hero-right"
        ref={rightPanelRef}
        onMouseMove={handleMouseMove}
        onMouseLeave={handleMouseLeave}
      >
        <div className="hero-next-race">
          Next Race
          <strong>British GP</strong>
          <div className="race-round">Silverstone · Rd 13</div>
        </div>

        {/* Base face/driver layer.
            NOTE: swap src for a real transparent driver photo/render once
            you have one — this SVG is a stand-in silhouette so the layout
            and mask effect can be reviewed before final art exists. */}
        <div className="face-layer">
          <FaceSilhouette />
        </div>

        {/* Helmet layer — follows mouse via spring physics */}
        <motion.div
          className="helmet-graphic"
          style={{ x: springX, y: springY }}
        >
          <HelmetSVG />
        </motion.div>

        <div className="hero-right-text">
          <div className="big">Predictor</div>
        </div>
      </div>
    </section>
  );
}

// Placeholder art — replace with real assets in /public when ready.
function FaceSilhouette() {
  return (
    <svg viewBox="0 0 400 520" fill="none" xmlns="http://www.w3.org/2000/svg" className="face-svg">
      <path d="M140 480 Q180 440 200 400 Q220 440 260 480 Q300 500 380 520 L20 520 Q100 500 140 480Z" fill="#0d0500"/>
      <ellipse cx="200" cy="280" rx="130" ry="155" fill="#1a0d00"/>
      <path d="M80 400 Q140 360 200 370 Q260 360 320 400 L340 520 L60 520Z" fill="#0a0a0a" stroke="#111" strokeWidth="1"/>
      <ellipse cx="160" cy="290" rx="18" ry="12" fill="#251000" opacity="0.6"/>
      <ellipse cx="240" cy="290" rx="18" ry="12" fill="#251000" opacity="0.6"/>
      <path d="M175 335 Q200 345 225 335" stroke="#1a0a00" strokeWidth="2" fill="none"/>
      <ellipse cx="72" cy="290" rx="14" ry="22" fill="#180c00"/>
      <ellipse cx="328" cy="290" rx="14" ry="22" fill="#180c00"/>
      <ellipse cx="200" cy="142" rx="128" ry="55" fill="#0a0500"/>
      <path d="M75 190 Q80 130 200 118 Q320 130 325 190 Q300 155 200 148 Q100 155 75 190Z" fill="#080300"/>
    </svg>
  );
}

