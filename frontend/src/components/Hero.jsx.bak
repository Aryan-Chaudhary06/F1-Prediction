  return (
    <svg viewBox="0 0 500 520" fill="none" xmlns="http://www.w3.org/2000/svg">
      <ellipse cx="250" cy="290" rx="200" ry="210" fill="#1a1a1a"/>
      <path d="M55 265 Q60 80 250 68 Q440 80 445 265" fill="#111" stroke="#222" strokeWidth="1.5"/>
      <path d="M80 148 Q250 108 420 148 Q415 132 250 120 Q85 132 80 148Z" fill="#E8002D"/>
      <path d="M90 165 Q250 130 410 165 L408 170 Q250 136 92 170Z" fill="#C8FF00" opacity="0.7"/>
      <rect x="185" y="96" width="130" height="32" rx="3" fill="#E8002D" opacity="0.9"/>
      <text x="250" y="116" textAnchor="middle" fill="white" fontSize="13" fontFamily="monospace" fontWeight="bold" letterSpacing="2">RACEMIND</text>
      <path d="M75 258 Q80 195 250 186 Q420 195 425 258 Q380 238 250 232 Q120 238 75 258Z" fill="#04040e" stroke="#C8FF00" strokeWidth="1" opacity="0.98"/>
      <path d="M100 220 Q250 208 400 220" stroke="rgba(200,255,0,0.25)" strokeWidth="2.5" strokeLinecap="round"/>
      <path d="M115 234 Q250 224 385 234" stroke="rgba(255,255,255,0.06)" strokeWidth="1.5" strokeLinecap="round"/>
      <path d="M76 258 Q80 196 250 187 Q420 196 424 258 Q380 240 250 233 Q120 240 76 258Z" fill="rgba(0,0,20,0.85)"/>
      <path d="M75 278 Q250 310 425 278 L422 315 Q250 355 78 315Z" fill="#0f0f0f" stroke="#1a1a1a" strokeWidth="1"/>
      <rect x="195" y="290" width="120" height="4" rx="2" fill="#080808"/>
      <rect x="210" y="300" width="90" height="3" rx="1.5" fill="#080808"/>
      <rect x="36" y="258" width="40" height="55" rx="6" fill="#E8002D"/>
      <rect x="424" y="258" width="40" height="55" rx="6" fill="#E8002D"/>
      <rect x="170" y="325" width="160" height="20" rx="2" fill="white" opacity="0.92"/>
      <text x="250" y="339" textAnchor="middle" fill="#111" fontSize="11" fontFamily="sans-serif" fontWeight="600" letterSpacing="3">McLAREN F1</text>
      <rect x="340" y="205" width="64" height="18" rx="2" fill="#C8FF00" opacity="0.9"/>
      <text x="372" y="218" textAnchor="middle" fill="#000" fontSize="9" fontFamily="monospace" fontWeight="bold">XGBoost</text>
      <ellipse cx="250" cy="290" rx="200" ry="210" fill="none" stroke="#2a2a2a" strokeWidth="1.5"/>
    </svg>
  );
}
