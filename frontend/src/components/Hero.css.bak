/* ── NAV ── */
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 500;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 3rem; height: 52px;
  background: rgba(5,5,5,0.92); backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--line);
}
.nav-logo { font-family: var(--font-display); font-weight: 900; font-size: 1.05rem; letter-spacing: 0.1em; text-transform: uppercase; }
.nav-logo span { color: var(--red); }
.nav-links { display: flex; gap: 2.2rem; list-style: none; }
.nav-links a { font-family: var(--font-display); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gray); }
.nav-links a:hover { color: var(--white); }
.nav-links a.active { color: var(--white); border-bottom: 1.5px solid var(--red); padding-bottom: 1px; }

/* ── HERO ── */
.hero {
  height: 100vh; position: relative; overflow: hidden;
  display: grid; grid-template-columns: 1fr 1fr;
}

.hero-left {
  position: relative; z-index: 10;
  display: flex; flex-direction: column; justify-content: flex-end;
  padding: 0 3rem 4rem;
  background: linear-gradient(90deg, var(--black) 60%, transparent 100%);
}

.hero-eyebrow {
  font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.2em;
  color: var(--red); text-transform: uppercase; margin-bottom: 1.2rem;
  opacity: 0; animation: fadeUp 0.7s 0.4s ease forwards;
}

.hero-h1 {
  font-family: var(--font-display); font-weight: 900;
  font-size: clamp(5.5rem, 10vw, 10rem);
  letter-spacing: -0.025em; line-height: 0.86; text-transform: uppercase;
  overflow: hidden;
}
.ln-slide {
  display: block; transform: translateY(110%);
  animation: slideUp 0.85s ease forwards;
}
.ln-slide.outline { color: transparent; -webkit-text-stroke: 1px var(--white); }
.ln-slide.red { color: var(--red); }

.hero-rule { width: 0; height: 1px; background: #222; margin: 1.8rem 0; animation: growW 0.7s 0.9s ease forwards; }

.hero-stats { display: flex; gap: 3rem; opacity: 0; animation: fadeUp 0.6s 1.1s ease forwards; }
.hstat-label { font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.16em; color: #444; text-transform: uppercase; margin-bottom: 0.3rem; }
.hstat-val { font-family: var(--font-display); font-weight: 700; font-size: 1.3rem; text-transform: uppercase; }
.pulse::before { content:''; display:inline-block; width:5px; height:5px; background:var(--lime); border-radius:50%; margin-right:7px; vertical-align:middle; animation:pulse 1.6s infinite; }

.hero-right { position: relative; overflow: hidden; }

.face-layer {
  position: absolute; inset: 0;
  background: radial-gradient(ellipse 55% 75% at 50% 45%, #1a0a00 0%, #0d0500 40%, #050505 100%);
  display: flex; align-items: center; justify-content: center;
}
.face-svg { width: 60%; max-width: 420px; opacity: 0.85; }

.helmet-graphic {
  position: absolute; top: 50%; left: 50%;
  width: 68%; max-width: 480px;
  margin-left: -34%; /* center via negative margin since x/y are spring-animated transforms */
  margin-top: -34%;
}
.helmet-graphic svg { width: 100%; height: auto; filter: drop-shadow(0 20px 60px rgba(0,0,0,0.9)); }

.hero-right-text {
  position: absolute; bottom: 4rem; right: 3rem;
  text-align: right; z-index: 10; pointer-events: none;
}
.hero-right-text .big {
  font-family: var(--font-display); font-weight: 900;
  font-size: clamp(2rem, 4vw, 3.5rem);
  text-transform: uppercase; letter-spacing: -0.01em; line-height: 1;
  color: transparent; -webkit-text-stroke: 1px #222;
  opacity: 0; animation: fadeUp 0.7s 1.3s ease forwards;
}

.hero-next-race {
  position: absolute; top: 5rem; right: 2.5rem;
  border: 1px solid #1a1a1a; padding: 1rem 1.2rem;
  font-family: var(--font-mono); font-size: 0.58rem;
  letter-spacing: 0.14em; text-transform: uppercase; color: #444;
  z-index: 10;
  opacity: 0; animation: fadeUp 0.6s 1.5s ease forwards;
}
.hero-next-race strong { display: block; color: var(--white); font-size: 0.8rem; margin-top: 0.3rem; }
.hero-next-race .race-round { color: var(--red); font-size: 0.55rem; margin-top: 0.2rem; }

@keyframes slideUp { to { transform: translateY(0); } }
@keyframes fadeUp { from { opacity:0; transform:translateY(18px); } to { opacity:1; transform:none; } }
@keyframes growW { to { width: 100%; } }
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.2} }

@media (max-width: 860px) {
  .hero { grid-template-columns: 1fr; }
  .hero-right { display: none; } /* mouse-follow effect needs a pointer; hide on mobile rather than fake it with touch */
}
